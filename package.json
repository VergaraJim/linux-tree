{
  "name": "linux-tree",
  "version": "1.0.1",
  "description": "A Sourcetree-style Git GUI for Linux with built-in git-flow",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:deb": "electron-vite build && electron-builder --linux deb",
    "dist:flatpak": "electron-vite build && electron-builder --linux flatpak"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@heroui/react": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.6",
    "vite": "^5.4.21"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "productName": "Linux Tree",
  "author": {
    "name": "jimvergara",
    "email": "vergarajim.info@gmail.com"
  },
  "build": {
    "appId": "link.vergara-jim.linuxtree",
    "productName": "Linux Tree",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "flatpak"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "linux-tree",
      "synopsis": "Sourcetree-style Git GUI with git-flow",
      "desktop": {
        "entry": {
          "StartupWMClass": "linux-tree"
        }
      }
    },
    "deb": {
      "depends": [
        "git",
        "openssh-client",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "24.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "24.08",
      "branch": "master",
      "useWaylandFlags": false,
      "artifactName": "linux-tree_${version}_${arch}.flatpak",
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--socket=ssh-auth",
        "--filesystem=home",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets"
      ],
      "modules": [
        {
          "name": "git",
          "buildsystem": "simple",
          "build-commands": [
            "make -j $FLATPAK_BUILDER_N_JOBS prefix=/app NO_GETTEXT=1 NO_TCLTK=1 NO_PERL=1 NO_PYTHON=1 NO_INSTALL_HARDLINKS=1 all",
            "make prefix=/app NO_GETTEXT=1 NO_TCLTK=1 NO_PERL=1 NO_PYTHON=1 NO_INSTALL_HARDLINKS=1 install"
          ],
          "sources": [
            {
              "type": "git",
              "url": "https://github.com/git/git.git",
              "tag": "v2.47.1"
            }
          ]
        },
        {
          "name": "openssh",
          "buildsystem": "simple",
          "build-commands": [
            "autoreconf",
            "sed -i 's/SSH_PORTABLE\\t\"p2\"/SSH_PORTABLE\\t\"p1\"/' version.h",
            "./configure --prefix=/app --sysconfdir=/app/etc/ssh --with-ssl-dir=/usr --without-pam --without-selinux --without-audit --without-kerberos5 --without-libedit --disable-strip",
            "make -j $FLATPAK_BUILDER_N_JOBS ssh scp sftp ssh-keygen ssh-keyscan",
            "mkdir -p /app/bin && install -m755 ssh scp sftp ssh-keygen ssh-keyscan /app/bin/"
          ],
          "sources": [
            {
              "type": "git",
              "url": "https://github.com/openssh/openssh-portable.git",
              "tag": "V_10_0_P1"
            }
          ]
        }
      ]
    }
  },
  "homepage": "https://app.vergara-jim.link/linux-tree/"
}
